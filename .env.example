# PostgreSQL connection. Use a pooled URL for runtime and a direct URL for migrations when required.
DATABASE_URL="postgresql://gametrade:change-me@localhost:5432/gametrade?schema=public"

# Generate at least 32 random bytes for each secret.
SESSION_SECRET="replace-with-a-long-random-session-secret"
OTP_SECRET="replace-with-a-different-long-random-otp-secret"
CRON_SECRET="replace-with-a-third-random-secret"

# Initial administrator, used only by prisma/seed.ts.
INITIAL_ADMIN_NAME="GameTrade MY Admin"
INITIAL_ADMIN_EMAIL="admin@example.com"
INITIAL_ADMIN_PHONE="+60123456789"
INITIAL_ADMIN_PASSWORD="replace-before-seeding"

# Local showcase content only. Never enable this in production.
SEED_DEMO_DATA="false"

# Public origin used for Origin checks and email links.
APP_URL="http://127.0.0.1:4173"

# Resend Email OTP provider.
RESEND_API_KEY=""
EMAIL_FROM="GameTrade MY <verify@example.com>"

# S3-compatible storage (Cloudflare R2, AWS S3, Backblaze B2, etc.).
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="gametrade-private"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# Manual payment account text displayed to authenticated buyers.
PAYMENT_BANK_NAME=""
PAYMENT_BANK_ACCOUNT=""
PAYMENT_DUITNOW_ID=""
